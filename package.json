{
  "name": "infinite-judge",
  "version": "5.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrightWeb-Dev-Team/InfiniteJudge.git"
  },
  "homepage": "https://github.com/BrightWeb-Dev-Team/InfiniteJudge",
  "bugs": {
    "url": "https://github.com/BrightWeb-Dev-Team/InfiniteJudge/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,key -c green,cyan,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:key-platform\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "dev:key-platform": "KEY_ADMIN_PORT=5031 node --watch server/key-admin.js",
    "start": "node server/index.js",
    "start:key-platform": "KEY_ADMIN_PORT=5031 node server/key-admin.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test server/*.test.js",
    "judge:worker": "node server/remote-worker.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "jose": "^6.2.12",
    "express": "4.22.3",
    "katex": "0.19.1",
    "lucide-react": "0.468.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tar": "^7.5.22",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "typescript": "5.7.2",
    "vite": "6.0.3"
  },
  "overrides": {
    "katex": "0.19.1",
    "proxy-addr": "2.0.8"
  }
}
